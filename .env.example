# Quote Catcher - variables d'environnement (exemple)
ENVIRONMENT=local

# Claude / Anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-latest

# GCP / Firestore
GCP_PROJECT_ID=
FIRESTORE_COLLECTION=qualifications

# Ponderation du score (somme = 1.0)
SCORE_WEIGHTS_CLARITY=0.30
SCORE_WEIGHTS_BUDGET=0.25
SCORE_WEIGHTS_URGENCY=0.20
SCORE_WEIGHTS_OFFER_FIT=0.25
